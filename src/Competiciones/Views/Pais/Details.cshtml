@using Competiciones.Models.Entities
@using Competiciones.Models.ViewModels

@model DetallesPaisViewModel
@{
	var rutaBandera = "~/images/" + (Model.Pais.rutaBandera ?? "Blanco.jpg");
}
<div class="row">
	<h1 class="col text-center">@Model.Titulo<img class="icono" src="@rutaBandera" alt="@Model.Pais.Name" asp-append-version="true" /></h1>
</div>
<div class="d-flex flex-column align-items-center">
	<table class="table mt-3 w-auto">
		<thead>
			<tr>
				<th class="text-center">Competicion</th>
			</tr>
		</thead>
		<tbody class="row">
			@foreach (Competicion competicion in Model.Pais.Competiciones)
			{

				<tr class="justify-content-center">
					<td>@competicion.Name</td>
					<td>
						<a class="btn btn-primary" asp-controller="Competicion" asp-action="Detalles" asp-route-id="@competicion.Id">Ver</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
	<div>

		<a class="btn btn-success" asp-controller="Pais" asp-action="Edit" asp-route-id="@Model.Pais.Id">Modificar</a>
		<button class="btn btn-primary" onclick="history.back()">Volver</button>
		<a class="btn btn-danger" asp-controller="Pais" asp-action="Delete" asp-route-id="@Model.Pais.Id">Eliminar</a>
	</div>


</div>