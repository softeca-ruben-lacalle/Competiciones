@using Competiciones.Models.ViewModels

@model EditarEquipoViewModel


@{
	ViewData["Title"] = "Editar Equipo";

	var rutaEscudo = "~/images/" + (Model.rutaEscudoExistente ?? "FotoBlanco.png");
}

<form asp-controller="Equipo" asp-action="Edit" method="post" class="m-2" enctype="multipart/form-data">
	<div asp-validation-summary="All" class="text-danger"> </div>
	<input hidden asp-for="Id" />
	<input hidden asp-for="rutaEscudoExistente" />
	<div class="input-group mb-3">
		<span class="input-group-text">Nombre</span>
		<input asp-for="Name" type="text" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="input-group mb-3">
		<span class="input-group-text">Pais</span>
		<select asp-for="PaisId"
				class="form-select mr-sm-2"
				asp-items="Model.Paises">
			<option value="">Seleccione uno</option>
		</select>
		<span asp-validation-for="PaisId" class="text-danger"></span>
	</div>
	<div class="input-group mb-3">
		<span class="input-group-text">Escudo</span>
		<input asp-for="Escudo" type="file" class="form-control" id="inputGroupFile04" aria-describedby="inputGroupFileAddon04" aria-label="Upload">
	</div>
	<div class="input-group row">
		<img class="img-thumbnail col-sm-4 offset-4" src="@rutaEscudo" asp-append-version="true" />
	</div>
	<div class="input-group mb-3">
		<div class="col-sm-10">
			<button type="submit" class="btn btn-primary">Modificar equipo</button>
			<button class="btn btn-primary" onclick="history.back()">Volver</button>
		</div>
	</div>

</form>