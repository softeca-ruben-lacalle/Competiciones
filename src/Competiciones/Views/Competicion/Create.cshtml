@using Competiciones.Models.Entities
@using Competiciones.Models.ViewModels
@model CrearCompeticionViewModel

@{
	ViewData["Title"] = "Crear Competicion";
}

<form asp-controller="Competicion" asp-action="Create" method="post" class="m-2">
	<div asp-validation-summary="All" class="text-danger"> </div>
	<span asp-validation-for="Name" class="text-danger"></span>
	<div class="input-group mb-3">
		<span class="input-group-text">Nombre</span>
		<input asp-for="Name" type="text" class="form-control" />
	</div>
	<span asp-validation-for="PaisId" class="text-danger"></span>
	<div class="input-group mb-3">
		<span class="input-group-text">Pais</span>
		<select asp-for="PaisId"
				class="form-select mr-sm-2"
				asp-items="Model.Paises">
			<option value="">Seleccione uno</option>
		</select>
	</div>
	<div class="input-group mb-3">
		<span>
			Equipos participantes:</h4>
			@foreach (Equipo equipo in Model.Equipos)
			{
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="equiposSeleccionados" value="@equipo.Id" />
					<label class="form-check-label">@equipo.Name</label>
				</div>
			}
	</div>
	<div class="input-group mb-3">
		<div class="col-sm-10">
			<button type="submit" class="btn btn-primary">Añadir competición</button>
			<button class="btn btn-primary" onclick="history.back()">Volver</button>
		</div>
	</div>
</form>