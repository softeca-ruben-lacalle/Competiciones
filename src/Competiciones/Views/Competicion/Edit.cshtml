@using Competiciones.Models.Entities
@using Competiciones.Models.ViewModels
@model EditarCompeticionViewModel

@{
	ViewData["Title"] = "Crear Competicion";
}

<form asp-controller="Competicion" asp-action="Edit" method="post" class="m-2">
	<input hidden asp-for="Id" />
	<div asp-validation-summary="All" class="text-danger"> </div>
	<div class="input-group mb-3">
		<span class="input-group-text">Nombre</span>
		<input asp-for="Name" type="text" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="input-group mb-3">
		<span class="input-group-text">Pais</span>
		<select asp-for="PaisId"
				class="form-select mr-sm-2"
				asp-items="Model.Paises">
			<option value="">Seleccione uno</option>
		</select>
		<span asp-validation-for="PaisId" class="text-danger"></span>
	</div>
	<a class="btn btn-success">Añadir Equipos</a>
	<div id="añadirEquipoDiv" class="mb-3">

		<h4>Equipos que participan:</h4>
		@foreach (Equipo equipo in Model.listaEquipos)
		{
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   name="equiposSeleccionados"
					   value="@equipo.Id"
					   @(Model.Equipos.Any(e => e.Id == equipo.Id) ? "checked" : "") />
				<label class="form-check-label">@equipo.Name</label>
			</div>
		}

	</div>
	<div class="input-group mb-3">
		<div class="col-sm-10">
			<button type="submit" class="btn btn-primary">Editar competición</button>
			<button class="btn btn-primary" onclick="history.back()">Volver</button>
		</div>
	</div>
</form>