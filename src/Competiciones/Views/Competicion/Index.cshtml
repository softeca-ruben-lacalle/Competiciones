@using Competiciones.Models.Entities
@model List<Competicion>
@{
	ViewData["Title"] = "Competiciones";
}

<div class="row">
	<h1 class="col"> Competiciones Registradas</h1>
	<a class="col-1 btn-add btn btn-dark" asp-controller="Competicion" asp-action="Create"><img src="~/img/agregarIcon.png" alt="Alternate Text" /></a>
</div>
<div class="container mt-4">
	<div class="row row-cols-3 gx-3">
		@foreach (Competicion competicion in Model)
		{
			var rutaBandera = "~/images/" + (competicion.Pais.rutaBandera ?? "Blanco.jpg");
			<div class="col mb-4 ">
				<div class="border border-2 border-dark rounded h-100 d-flex flex-column">
					<div class="card-header">
						<h5 class="card-title text-center">@competicion.Name<img class="ms-1" src="@rutaBandera" alt="@competicion.Pais.Name" asp-append-version="true" style="width:32px" /> </h5>
					</div>
					<div class="card-body flex-grow-1">
						@if (competicion.Equipos.Count() > 0)
						{
							<table class="table-bordered  w-100">
								<thead>
									<tr>
										<th class="ps-3">Equipos</th>
									</tr>
								</thead>
								<tbody>
									@foreach (Equipo equipo in competicion.Equipos)
									{
										<tr><td class="ps-3">@equipo.Name</td></tr>
									}
								</tbody>
							</table>
						}
						else
						{
							<div class="mh-100 mw-100 text-center">No hay equipos en esta competicion</div>
						}
					</div>
					<div class="card-footer d-flex justify-content-evenly">
						<a class="btn btn-primary" asp-controller="Competicion" asp-action="Details" asp-route-id="@competicion.Id">Mostrar más</a>
						<a class="btn btn-success" asp-controller="Competicion" asp-action="Edit" asp-route-id="@competicion.Id">Modificar</a>
						<a class="btn btn-danger" asp-controller="Competicion" asp-action="Delete" asp-route-id="@competicion.Id">Eliminar</a>
					</div>
				</div>
			</div>
		}
	</div>
</div>

