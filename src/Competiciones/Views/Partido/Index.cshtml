@using Competiciones.Models.Entities
@model List<Partido>

@{
	var ahora = DateTime.Now;

	var proximos = Model
		.Where(p => p.Horario >= ahora)
		.OrderBy(p => p.Horario)
		.ToList();

	var jugados = Model
		.Where(p => p.Horario < ahora)
		.OrderByDescending(p => p.Horario)
		.ToList();
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="fw-bold">Partidos</h1>
		<a class="btn btn-primary" asp-action="Create">➕ Crear Partido</a>
	</div>
	<div class="row">
		<div class="col-12">
			<div id="calendar"></div>
		</div>
	</div>

	<div class="row">

		<!-- Próximos Partidos -->
		<div class="col-md-6">
			<h3 class="mb-3 text-primary">Próximos Partidos</h3>

			@if (proximos.Count() == 0)
			{
				<p class="text-muted">No hay partidos programados.</p>
			}
			else
			{
				<div class="row g-3">
					@foreach (var p in proximos)
					{
						<a class="nd" asp-controller="Partido" asp-action="Details" asp-route-id="@p.Id">
							<div class="col-12">
								<div class="card shadow-sm border-0">
									<div class="card-body">

										<div class="d-flex justify-content-between align-items-center">
											<div class="text-center flex-fill">
												<h5 class="fw-bold">@p.EquipoLocal.Name</h5>
											</div>

											<div class="px-3 text-center">
												<span class="badge bg-primary fs-6">@p.Horario.ToString("dd/MM HH:mm")</span>
												<div class="small text-muted">@p.Competicion.Name</div>
											</div>

											<div class="text-center flex-fill">
												<h5 class="fw-bold">@p.EquipoVisitante.Name</h5>
											</div>
										</div>

									</div>
								</div>
							</div>
						</a>
					}
				</div>
			}
		</div>

		<!-- Partidos Jugados -->
		<div class="col-md-6">
			<h3 class="mb-3 text-success">Partidos Jugados</h3>

			@if (jugados.Count() == 0)
			{
				<p class="text-muted">No hay partidos jugados aún.</p>
			}
			else
			{
				<div class="row g-3">
					@foreach (var p in jugados)
					{
						<a class="nd" asp-controller="Partido" asp-action="Details" asp-route-id="@p.Id">
							<div class="col-12">
								<div class="card shadow-sm border-0 bg-light">
									<div class="card-body">

										<div class="d-flex justify-content-between align-items-center">
											<div class="text-center flex-fill">
												<h5 class="fw-bold">@p.EquipoLocal.Name</h5>
											</div>

											<div class="px-3 text-center">
												<span class="badge bg-secondary fs-6">@p.Horario.ToString("dd/MM HH:mm")</span>
												<div class="small text-muted">@p.Competicion.Name</div>
												@{
													if (p.Resultado == null)
													{
														<span class="badge bg-secondary">Se desconoce resultado</span>
													}
													else
													{
														<span class="badge bg-success">@p.Resultado</span>
													}
												}
											</div>

											<div class="text-center flex-fill">
												<h5 class="fw-bold">@p.EquipoVisitante.Name</h5>
											</div>
										</div>

									</div>
								</div>
							</div>
						</a>
					}
				</div>
			}
		</div>


	</div>
</div>
@section Scripts {
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var calendarEl = document.getElementById('calendar');

			var calendar = new FullCalendar.Calendar(calendarEl, {
				initialView: 'dayGridMonth',
				selectable: true,
				eventTimeFormat: {hour: '2-digit', minute: '2-digit',hour12: false},
				events: '/Partido/GetAll',
				fixedWeekCount: false,
				firstDay: 1,
				eventClick: function(p) {window.location.href = '/Partido/Details/' + p.event.id}});
			calendar.render();
		});
	</script>
}