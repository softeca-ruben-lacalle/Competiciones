@using Competiciones.Models.ViewModels
@using System.Text.Json

@model DetallesJugadorViewModel

@{
	var rutaEscudo = "~/images/" + (Model.Jugador.Equipo.RutaEscudo ?? "Blanco.jpg");
	var rutaPais = "~/images/" + (Model.Jugador.Pais.rutaBandera ?? "Blanco.jpg");
}



<div class="row">
	<h1 class="col text-center">Ficha Jugador</h1>
</div>
<div class="d-flex justify-content-center">
	<table class="table mt-3 w-auto">
		<tbody>
			<tr>
				<td>Nombre completo</td>
				<td>@Model.Jugador.Name @Model.Jugador.LastNames <img src="@rutaPais" alt="@Model.Jugador.Pais.Name" asp-append-version="true" style="width:32px" /></td>
			</tr>
			<tr>
				<td>Equipo</td>
				<td>@Model.Jugador.Equipo.Name <img src="@rutaEscudo" alt="@Model.Jugador.Equipo.Name" asp-append-version="true" style="width:32px"/></td>

			</tr>
			<tr>
				<td>Peso</td>
				<td>@Model.Jugador.Peso Kg</td>
			</tr>
			<tr>
				<td>Altura</td>
				<td>@Model.Jugador.Altura cm</td>
			</tr>
			<tr>
				<td>Edad</td>
				<td>@Model.Jugador.Edad</td>
			</tr>
			<tr>
				<td colspan="2" class="text-end">
					<button class="btn btn-primary" onclick="history.back()">Volver</button>
					<a class="btn btn-success" asp-controller="Jugador" asp-action="Edit" asp-route-id="@Model.Jugador.Id">Editar</a>
					<a class="btn btn-danger">Eliminar</a>
				</td>
			</tr>
		</tbody>
	</table>

</div>